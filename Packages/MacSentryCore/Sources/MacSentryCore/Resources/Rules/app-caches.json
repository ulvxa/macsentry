  {
    "id": "appcache.chromium",
    "group": "App Caches",
    "category": "appCache",
    "tier": "green",
    "action": "quarantine",
    "match": {
      "appScope": {
        "root": "~/Library/Application Support",
        "names": [
          "Code Cache",
          "GPUCache",
          "DawnCache",
          "DawnWebGPUCache",
          "DawnGraphiteCache",
          "GraphiteDawnCache",
          "ShaderCache",
          "GrShaderCache",
          "Service Worker/CacheStorage",
          "Service Worker/ScriptCache",
          "CachedData"
        ],
        "maxDepth": 4,
        "excludeTopPrefixes": [
          "com.apple."
        ],
        "vendorFolders": true,
        "unattributedReason": "Chromium or Electron engine cache (compiled scripts, GPU shaders, service worker cache). It is rebuilt on the next launch. MacSentry could not tell which app owns this folder, so it cannot check whether that app is running. Quit the app that owns it before moving it."
      },
      "claimWholeFolder": true
    },
    "appBundleIDs": [],
    "requiresAppQuit": true,
    "reason": "Chromium or Electron engine cache (compiled scripts, GPU shaders, service worker cache). The app rebuilds it on the next launch. Quit the app that owns this folder first.",
    "verify": false
  },
