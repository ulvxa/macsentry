  {
    "id": "appcache.generic",
    "group": "App Caches",
    "category": "appCache",
    "tier": "green",
    "action": "quarantine",
    "match": {
      "installedAppFolder": "applicationSupport",
      "subpaths": [
        "Cache",
        "Code Cache",
        "GPUCache",
        "DawnCache",
        "Service Worker/CacheStorage",
        "CachedData"
      ],
      "claimWholeFolder": true
    },
    "appBundleIDs": [],
    "requiresAppQuit": true,
    "reason": "Browser engine cache of an installed app. The app recreates it on the next launch.",
    "verify": false
  },
